# ─────────────────────────────────────────────────
# Mediarr environment configuration
# ─────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored; never commit real secrets.

# ─── Docker Deployment ───────────────────────────
# These variables are consumed directly by docker-compose.yml.
# CONFIG_DIR  – Host path for persistent configuration & SQLite database.
#               Default: ./config (relative to compose file)
# MEDIA_DIR   – Host path for media files (downloads, movies, TV shows).
#               Default: ./data
# PUID / PGID – User/group ID for file ownership on bind-mounted volumes.
#               Must match your host user's IDs (default 1000:1000).
# MEDIARR_API_PORT – Port the server listens on (default 5174). With host networking,
#               browse to http://<host-lan-ip>:5174 unless you change this.
# ENCRYPTION_KEY – Required secret for sensitive values in the database.
# Generate one with: openssl rand -hex 32
CONFIG_DIR=./config
MEDIA_DIR=./data
PUID=1000
PGID=1000
MEDIARR_API_PORT=5174
ENCRYPTION_KEY=

# ─── Standalone / Development ────────────────────
# Host migration rehearsal (after sourcing this file):
# DATABASE_URL="file:$CONFIG_DIR/mediarr.db" npm run migrate
API_INTERNAL_URL=http://localhost:5174

# ─── AI Release Parser ───────────────────────────
# Entirely optional. With no provider configured, ReleaseParser falls back to a
# regex that handles SxxExx and lone-season titles only.
#
# The default is a ROUTER (openrouter/pareto-code), not a pinned model, so the
# parser keeps working when an individual model is retired.
#
# CHOOSE A FAST MODEL if you override. Every call has an abort deadline (see
# below), and a model slower than its deadline fails silently: parse() returns the
# regex result and parseBatch() returns empty slots, so the parser appears to work
# while doing nothing. Measured 2026-07-28 over the 48-title golden set at the
# production batch size of 25, temperature=0:
#
#   openrouter/pareto-code        13.3–20.3s  $0.142/1000  <- default (score 0)
#   google/gemini-2.5-flash-lite   5.0–7.2s   $0.047
#   openrouter/auto                14–21s     $4.41
#   openrouter/free                31–35s     $0       (truncated 6-of-8)
#   minimax/minimax-m2.7           77–88s     $0.61    (former default; never
#                                                       completed inside 15s)
OPENROUTER_API_KEY=
# Optional override. Leave unset to use openrouter/pareto-code.
OPENROUTER_MODEL=

# Quality/cost dial for the pareto router, 0..1. Ignored for fixed models.
# Higher demands a stronger model from the router's shortlist and costs more.
# Measured 2026-07-28 over 8 titles — every rung parsed correctly, so the floor is
# the default and quality is bought only on retry:
#   0     -> gpt-5.6-luna    6.9s   $0.142/1000   <- default
#   0.25  -> gpt-5.6-luna    7.0s   $0.144/1000
#   0.5   -> gpt-5.6-terra   2.4s   $0.295/1000
#   0.75  -> gpt-5.6-sol    13.2s   $1.827/1000
#   1     -> gpt-5.6-sol     7.6s   $1.643/1000
# Each retry after a failed attempt raises this by 0.10 automatically, so a hard
# title escalates to a stronger model instead of repeating the same failure.
# RELEASE_PARSER_MIN_CODING_SCORE=0

# Optional OpenAI-compatible gateway. Takes precedence over OPENROUTER_* when
# AI_GATEWAY_BASE_URL and a model are both set. Unset by default: the previous
# example value pointed at a localhost gateway that is not running, and named a
# model (openrouter/free) measured at 31–35s against a 20s deadline.
# AI_GATEWAY_BASE_URL=http://localhost:3030/api/v1
# AI_GATEWAY_MODEL=
# AI_GATEWAY_API_KEY=

# Abort deadlines and concurrency. Defaults shown; all optional.
# Non-positive or non-integer values are ignored and the default is used.
# RELEASE_PARSER_PARSE_TIMEOUT_MS=30000    # single title
# RELEASE_PARSER_BATCH_TIMEOUT_MS=60000    # up to 25 titles per call
# RELEASE_PARSER_FILES_TIMEOUT_MS=90000    # up to 50 paths per call
# RELEASE_PARSER_MAX_CONCURRENCY=4         # in-flight single-title parses
