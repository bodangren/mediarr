# Mediarr environment configuration — copy to .env and fill in your values
# .env is git-ignored; never commit real secrets

DATABASE_URL="file:../mediarr.db"
API_PORT=3001
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=
ENCRYPTION_KEY=change-me-to-a-random-string

# LLM provider API keys (optional — ReleaseParser falls back to regex)
GLM_API_KEY=
DEEPSEEK_API_KEY=

# AI Gateway Router
AI_GATEWAY_BASE_URL=http://localhost:3030/api/v1
AI_GATEWAY_MODEL=openrouter/free
