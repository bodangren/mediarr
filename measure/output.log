import re

with open('server/src/main.ts', 'r') as f:
    content = f.read()

# Add helper function after imports
helper = '''
function executeRaw(sqlite: any, query: string, ...params: unknown[]): number {
  const stmt = sqlite.prepare(query);
  const result = stmt.run(...params);
  return Number(result.changes ?? 0);
}
'''

# Find a good place to insert the helper (after the last import)
import_end = content.rfind("import ")
next_newline = content.find("\n", import_end)
while next_newline != -1 and content[next_newline+1].strip() == "":
    next_newline = content.find("\n", next_newline + 1)

# Insert helper
content = content[:next_newline+1] + helper + content[next_newline+1:]

# Replace all prisma.sqlite.exec(...) with executeRaw(prisma.sqlite, ...)
# Pattern: await prisma.sqlite.exec(`...`)
content = re.sub(
    r'await prisma\.sqlite\.exec\((.*?)\);',
    r'executeRaw(prisma.sqlite, \1);',
    content,
    flags=re.DOTALL
)

with open('server/src/main.ts', 'w') as f:
    f.write(content)

print("Done")
PYEOF
