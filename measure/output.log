+          typeof settings.baseUrl === 'string'
+            ? settings.baseUrl
+            : typeof settings.url === 'string'
+              ? settings.url
+              : typeof settings.host === 'string'
+                ? settings.host
+                : null;
+        if (indexerUrl && indexerUrl === entry.baseUrl) {
+          return true;
+        }
+      }
+
+      return false;
+    });
+  }
