   app: FastifyInstance,
   deps: ApiDependencies,
 ): void {
+  app.get('/api/media/library', {
+    schema: {
+      querystring: {
+        type: 'object',
+        properties: {
+          page: { type: ['number', 'string'] },
+          pageSize: { type: ['number', 'string'] },
+          sortBy: { type: 'string' },
+          sortDir: { type: 'string' },
+          type: { type: 'string' },
+        },
+      },
+    },
