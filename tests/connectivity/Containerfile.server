# Mediarr server container for connectivity E2E tests.
# Uses Node 20 + tsx — simpler than Bun in containers because better-sqlite3
# and drizzle-kit both compile and run against the same Node ABI.

FROM node:20-slim

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        python3 \
        make \
        g++ \
        curl \
        sqlite3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────────────────────
COPY package.json package-lock.json* ./
COPY server/package.json ./server/
COPY app/package.json ./app/
# Build better-sqlite3 native bindings for Node 20.
RUN npm ci

# ── Source ────────────────────────────────────────────────────────────────────
COPY server/ ./server/
COPY drizzle/ ./drizzle/
COPY drizzle.config.ts ./
COPY tsconfig.json ./
COPY tests/connectivity/scripts/ ./tests/connectivity/scripts/

# ── Generate fixture MP4s at build time (~50KB each, deterministic) ──────────
RUN mkdir -p \
    "/data/media/movies/connectivity-test-movie" \
    "/data/media/tv/connectivity-test-series/Season 01" && \
    ffmpeg -y -f lavfi -i testsrc=duration=2:size=320x240:rate=24 \
           -c:v libx264 -pix_fmt yuv420p -movflags +faststart \
           "/data/media/movies/connectivity-test-movie/Connectivity Test Movie (2026).mp4" && \
    ffmpeg -y -f lavfi -i testsrc=duration=2:size=320x240:rate=24 \
           -c:v libx264 -pix_fmt yuv420p -movflags +faststart \
           "/data/media/tv/connectivity-test-series/Season 01/Connectivity Test Series - S01E01.mp4"

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY tests/connectivity/server-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV DATABASE_URL=file:/tmp/connectivity.db
ENV NODE_ENV=test
ENV API_PORT=8080
ENV ENCRYPTION_KEY=connectivity-test-key
ENV DEFINITIONS_PATH=/app/server/definitions

EXPOSE 8080

HEALTHCHECK --interval=3s --timeout=5s --start-period=60s --retries=20 \
  CMD curl -sf http://localhost:8080/api/system/status || exit 1

ENTRYPOINT ["/entrypoint.sh"]
